# ──────────────────────────────────────────────────────────
# Line endings
# ──────────────────────────────────────────────────────────
# Normalize to LF in the index and check out LF everywhere. The tree is
# LF-clean today (zero CRLF files, zero BOMs — verified before adding this),
# and the shell scripts under scripts/ run inside a Linux container image: a
# Windows clone with core.autocrlf=true would otherwise hand the sandbox CRLF
# `.sh` files that die with "bad interpreter". The executable text types are
# pinned explicitly so the guarantee survives someone loosening `text=auto`.
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# ──────────────────────────────────────────────────────────
# Binary assets — never diffed, never eol-converted
# ──────────────────────────────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.node binary

# ──────────────────────────────────────────────────────────
# Generated code
# ──────────────────────────────────────────────────────────
# Codex app-server protocol bindings are auto-generated by
# scripts/codegen-codex.mjs (ts-rs + schemars export from openai/codex).
# Mark them as generated so GitHub collapses them in diffs and excludes
# them from language stats — they're ~118k lines of "DO NOT MODIFY BY HAND".
# Provenance for the same tree is recorded in THIRD-PARTY-NOTICES.md: the mark
# is about diff noise, not about obscuring where the code came from.
src/engine/agents/adapters/codex/generated/** linguist-generated=true

# JSON Schemas emitted by scripts/build-settings-schemas.ts and published from
# the marketing site. Tracked so Cloudflare Pages can serve them, but they are
# build output, not hand-written JSON.
website/marketing/public/schemas/*.json linguist-generated=true

# ──────────────────────────────────────────────────────────
# Vendored / non-source trees — keep the language bar honest
# ──────────────────────────────────────────────────────────
# This is a TypeScript project. Left unmarked, large hand-written HTML labs can
# distort GitHub's language bar and misrepresent what the repo is.
styles/Artifacts/** linguist-documentation=true

# Local dev harness page (paired with src/harness-model-menu.tsx), not app
# source and not part of the production bundle.
harness-model-menu.html linguist-documentation=true
