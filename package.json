{
  "name": "zeros",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Local-first macOS app that runs coding agents (Claude Code, Codex, Cursor) in parallel git worktrees, with an embedded browser and terminal.",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "electronmon": {
    "patterns": [
      "!**/*.0c",
      "!**/.zeros/**",
      "!dist-engine/**",
      "!binaries/**",
      "!untitled.0c",
      "!.git/**",
      "!docs/**",
      "!**/*.log",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal"
    ]
  },
  "codexProtocolVersion": "0.146.0",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-helper.cjs",
    "codegen:codex": "node scripts/codegen-codex.mjs",
    "build:engine": "node scripts/codegen-codex.mjs && tsup",
    "watch:engine": "node scripts/codegen-codex.mjs && tsup --watch",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "stage:claude-cli": "node scripts/stage-claude-cli.mjs",
    "smoke:engine": "node scripts/smoke-engine.mjs",
    "smoke:packaged-pty": "node scripts/packaged-pty-smoke.mjs",
    "version:current": "node scripts/compute-version.mjs",
    "version:set": "node scripts/compute-version.mjs --set",
    "changelog:new": "node scripts/changelog-new.mjs",
    "dev": "vite",
    "serve:loaders": "node scripts/serve-loaders.mjs",
    "test:ui": "vite",
    "build:ui": "vite build",
    "serve:engine": "node dist-engine/cli.js",
    "electron:compile": "tsup --config electron/tsup.config.ts",
    "electron:compile:watch": "tsup --config electron/tsup.config.ts --watch",
    "electron:rename-dev": "node scripts/rename-electron-dev-binary.cjs",
    "electron:dev:prep": "pnpm electron:rebuild && pnpm build:engine && pnpm electron:compile",
    "electron:dev": "pnpm electron:dev:prep && node scripts/dev-instance.mjs",
    "electron:dev:watch": "pnpm electron:dev:prep && node scripts/dev-instance.mjs --watch",
    "electron:run": "pnpm electron:dev:prep && node scripts/dev-instance.mjs --run-only",
    "electron:rebuild": "node scripts/electron-rebuild-sqlite.cjs",
    "doctor": "node scripts/doctor.mjs",
    "electron:build": "pnpm build:sidecar && pnpm electron:compile && pnpm build:ui && node scripts/electron-builder-run.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "check:preload": "node scripts/check-preload-allowlist.mjs",
    "check:cursor-asar": "node scripts/check-cursor-asar-unpack.mjs",
    "check:migrations": "tsx scripts/check-migrations-forward-only.mts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:vite-env": "node scripts/check-vite-env-sync.mjs",
    "check:electron-hardening": "node scripts/check-electron-hardening.mjs",
    "check:codex-pin": "node scripts/check-codex-pin.mjs",
    "check:runtime-pins": "node scripts/check-runtime-pins.mjs",
    "check:packaging-paths": "node scripts/check-packaging-paths.mjs",
    "check:backend-migrations": "node scripts/check-backend-migrations.mjs",
    "check:protocol": "node scripts/check-protocol-version.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:web-deploy": "node scripts/check-web-deploy.mjs",
    "check:deep-link-schemes": "node scripts/check-deep-link-schemes.mjs",
    "snap:ui": "node scripts/visual-harness.mjs",
    "test:adapters": "node scripts/test-adapters.mjs",
    "agents:smoke": "node scripts/agent-smoke.mjs",
    "cursor:smoke": "node scripts/cursor-host-smoke.mjs",
    "models:list": "node scripts/models-list.mjs",
    "models:verify": "node scripts/models-verify.mjs",
    "test:git": "vitest run --config vitest.config.ts",
    "test:git:watch": "vitest --config vitest.config.ts",
    "test:workspace-lifecycle": "vitest run --config vitest.config.ts src/engine/git/__tests__/workspace-base-lifecycle.test.ts src/engine/git/__tests__/branch-catalog.test.ts src/engine/git/__tests__/branch.test.ts src/engine/git/__tests__/default-branch-freshness.test.ts src/engine/git/__tests__/watch.test.ts src/engine/git/__tests__/cleanup.test.ts src/engine/git/__tests__/worktree.test.ts src/engine/git/__tests__/worktree-seed.test.ts src/engine/git/__tests__/workspace-files.test.ts src/engine/git/__tests__/cross-tool.test.ts src/engine/git/__tests__/phase0-fixes.test.ts src/engine/git/__tests__/repo-scripts.test.ts src/engine/git/__tests__/git-exec.test.ts src/engine/git/__tests__/engine-token-store.test.ts src/engine/git/__tests__/github.test.ts src/engine/git/__tests__/publish-github.test.ts src/engine/git/__tests__/sync-workspace-pr.test.ts src/engine/settings/__tests__/files.test.ts src/engine/settings/__tests__/resolve.test.ts src/engine/settings/__tests__/schema.test.ts src/engine/workspace/__tests__/service.test.ts src/engine/pty/__tests__/registry.test.ts src/engine/pty/__tests__/service.test.ts src/engine/agents/__tests__/gateway-end-session.test.ts src/zeros/bridge/__tests__/workspace-bridge.test.ts src/native/__tests__/workspace-operation-errors.test.ts src/zeros/agent/__tests__/new-chat-defaults.test.ts src/zeros/agent/__tests__/sessions-store-agent-exit.test.ts src/zeros/agent/__tests__/sessions-store-detach.test.ts src/zeros/lib/__tests__/workspace-card-action.test.ts src/zeros/panels/__tests__/repo-branch-catalog-cache.test.ts src/shell/__tests__/column3-fresh-workspace.test.ts src/zeros/store/__tests__/active-chat-per-workspace.test.ts src/zeros/store/__tests__/archive-navigation.test.ts src/zeros/store/__tests__/keyed-async-cache.test.ts src/zeros/store/__tests__/live-workspace-selectors.test.ts src/zeros/store/__tests__/pending-workspaces.test.ts src/zeros/store/__tests__/workspace-cache-transitions.test.ts src/zeros/store/__tests__/workspace-create-intents.test.ts src/zeros/store/__tests__/workspace-list-persistence.test.ts src/zeros/store/__tests__/workspace-resolution.test.ts src/zeros/store/__tests__/chat-panes-store.test.ts src/zeros/store/__tests__/chat-selection-invariant.test.ts",
    "lint": "eslint src electron",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:electron && pnpm typecheck:packages",
    "typecheck:app": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.typecheck.json",
    "typecheck:packages": "pnpm --filter @zeros/core run typecheck && pnpm --filter @zeros/feedback-intercom-webhook run typecheck && pnpm --filter @zeros/marketing run typecheck",
    "schemas:build": "tsx scripts/build-settings-schemas.ts",
    "test:ui-smoke": "node scripts/ui-smoke-composer.mjs",
    "test:backend": "pnpm --dir backend test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@cursor/sdk": "1.0.26",
    "@decimalturn/toml-patch": "^2.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.0",
    "@openai/codex": "0.146.0",
    "@pierre/diffs": "1.2.11",
    "@pierre/trees": "1.0.0-beta.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-document": "3.26.0",
    "@tiptap/extension-mention": "3.26.0",
    "@tiptap/extension-paragraph": "3.26.0",
    "@tiptap/extension-text": "3.26.0",
    "@tiptap/extensions": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/suggestion": "3.26.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@zeros/core": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.1",
    "electron-updater": "^6.8.3",
    "fix-path": "^5.0.0",
    "isomorphic-git": "^1.27.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.2",
    "nanoid": "^5.1.11",
    "node-pty": "^1.1.0",
    "postcss": "^8.4.0",
    "posthog-js": "^1.379.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.14.0",
    "shiki": "^4.0.2",
    "smol-toml": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tinyglobby": "^0.2.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@daytona/sdk": "0.190.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.19.39",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.5"
  },
  "keywords": [
    "design",
    "mac-app",
    "electron",
    "inspector",
    "ai",
    "agent",
    "visual",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withso/zeros.git"
  },
  "homepage": "https://github.com/withso/zeros#readme",
  "bugs": {
    "url": "https://github.com/withso/zeros/issues"
  },
  "//pnpm": "pnpm v10 moved package-level pnpm settings to pnpm-workspace.yaml. See `onlyBuiltDependencies` there."
}
