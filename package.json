    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
