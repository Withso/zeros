{
  "name": "zeros",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Local-first macOS workspace for running coding agents in parallel Git worktrees with integrated review, browser, and terminal surfaces.",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "electronmon": {
    "patterns": [
      "!**/*.0c",
      "!**/.zeros/**",
      "!dist-engine/**",
      "!binaries/**",
      "!untitled.0c",
      "!.git/**",
      "!docs/**",
      "!**/*.log",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal"
    ]
  },
  "codexProtocolVersion": "0.149.0",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-helper.cjs",
    "codegen:codex": "node scripts/codegen-codex.mjs",
    "build:engine": "node scripts/codegen-codex.mjs && tsup",
    "watch:engine": "node scripts/codegen-codex.mjs && tsup --watch",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:zsr-supervisor": "node scripts/build-zsr-supervisor.mjs",
    "stage:claude-cli": "node scripts/stage-claude-cli.mjs",
    "stage:codex-cli": "node scripts/stage-codex-cli.mjs",
    "smoke:engine": "node scripts/smoke-engine.mjs",
    "smoke:browser-service": "node scripts/browser-service-smoke.mjs",
    "smoke:packaged-pty": "node scripts/packaged-pty-smoke.mjs",
    "version:current": "node scripts/compute-version.mjs",
    "version:set": "node scripts/compute-version.mjs --set",
    "changelog:new": "node scripts/changelog-new.mjs",
    "dev": "vite",
    "serve:loaders": "node scripts/serve-loaders.mjs",
    "test:ui": "vite",
    "build:ui": "vite build",
    "serve:engine": "node dist-engine/cli.js",
    "electron:compile": "tsup --config apps/desktop/electron/tsup.config.ts",
    "electron:compile:watch": "tsup --config apps/desktop/electron/tsup.config.ts --watch",
    "electron:rename-dev": "node scripts/rename-electron-dev-binary.cjs",
    "electron:dev:prep": "pnpm electron:rebuild && pnpm build:zsr-supervisor && pnpm build:engine && pnpm electron:compile",
    "electron:dev": "pnpm electron:dev:prep && node scripts/dev-instance.mjs --watch",
    "electron:dev:watch": "pnpm electron:dev:prep && node scripts/dev-instance.mjs --watch",
    "electron:run": "pnpm electron:dev:prep && node scripts/dev-instance.mjs --run-only",
    "electron:rebuild": "node scripts/electron-rebuild-sqlite.cjs",
    "doctor": "node scripts/doctor.mjs",
    "electron:build": "pnpm build:zsr-supervisor && pnpm build:sidecar && pnpm electron:compile && pnpm build:ui && node scripts/electron-builder-run.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "check:preload": "node scripts/check-preload-allowlist.mjs",
    "check:cursor-asar": "node scripts/check-cursor-asar-unpack.mjs",
    "check:migrations": "tsx scripts/check-migrations-forward-only.mts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "licenses:prepare": "node scripts/prepare-third-party-license-graphs.mjs",
    "licenses:generate": "pnpm licenses:prepare && node scripts/generate-third-party-licenses.mjs",
    "check:licenses": "pnpm licenses:prepare && node scripts/generate-third-party-licenses.mjs --check",
    "check:vite-env": "node scripts/check-vite-env-sync.mjs",
    "check:electron-hardening": "node scripts/check-electron-hardening.mjs",
    "check:codex-coverage": "node scripts/codex-protocol-coverage.mjs",
    "check:codex-pin": "node scripts/check-codex-pin.mjs && node scripts/codex-protocol-coverage.mjs",
    "check:runtime-pins": "node scripts/check-runtime-pins.mjs",
    "zsr:qualify": "pnpm build:zsr-supervisor && node scripts/zsr-qualification/run.mjs",
    "check:zsr": "pnpm build:zsr-supervisor && node scripts/zsr-qualification/run.mjs --require-secure",
    "check:zsr:orbstack": "tsx scripts/zsr-qualification/macos-orbstack-controller.ts",
    "check:zsr-preview-browser": "tsx scripts/zsr-preview-browser-smoke.ts",
    "check:packaging-paths": "node scripts/check-packaging-paths.mjs",
    "check:control-plane-migrations": "node scripts/check-control-plane-migrations.mjs",
    "check:protocol": "node scripts/check-protocol-version.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:web-deploy": "node scripts/check-web-deploy.mjs",
    "check:deep-link-schemes": "node scripts/check-deep-link-schemes.mjs",
    "snap:ui": "node scripts/visual-harness.mjs",
    "test:adapters": "node scripts/test-adapters.mjs",
    "agents:smoke": "pnpm build:zsr-supervisor && node scripts/agent-smoke.mjs",
    "cursor:smoke": "node scripts/cursor-host-smoke.mjs",
    "cursor:smoke:electron": "node scripts/cursor-host-smoke.mjs --electron",
    "cursor:smoke:stored-admission": "pnpm build:zsr-supervisor && electron scripts/cursor-stored-admission-smoke.cjs",
    "codex:smoke": "node scripts/codex-app-server-smoke.mjs",
    "claude:smoke": "node scripts/claude-cli-smoke.mjs",
    "agents:smoke:offline": "pnpm claude:smoke && pnpm codex:smoke && pnpm cursor:smoke && pnpm cursor:smoke:electron",
    "models:list": "node scripts/models-list.mjs",
    "models:verify": "node scripts/models-verify.mjs",
    "test:git": "vitest run --config vitest.config.ts",
    "test:git:watch": "vitest --config vitest.config.ts",
    "check:design-containment": "node scripts/run-explicit-vitest.mjs packages/design-web/src/__tests__/foundation-acceptance.test.ts packages/design-web/src/__tests__/playwright-renderer.test.ts apps/desktop/src/engine/agents/__tests__/gateway-cwd-hint.test.ts apps/desktop/src/engine/agents/__tests__/territory-resolution.test.ts apps/desktop/src/engine/agents/adapters/shared/__tests__/stdio-process.test.ts apps/desktop/src/engine/agents/adapters/codex/__tests__/app-server-adapter-params.test.ts apps/desktop/src/engine/agents/adapters/codex/__tests__/territory.test.ts apps/desktop/src/engine/agents/adapters/claude-sdk/__tests__/adapter.test.ts apps/desktop/src/engine/agents/adapters/claude-sdk/__tests__/contained-process.test.ts apps/desktop/src/engine/agents/adapters/claude-sdk/__tests__/territory.test.ts apps/desktop/src/engine/design/__tests__/agent-isolation.test.ts apps/desktop/src/engine/design/__tests__/containment-guarantees.test.ts apps/desktop/src/engine/design/__tests__/document-write-lock.test.ts apps/desktop/src/engine/design/__tests__/screenshots.test.ts apps/desktop/src/engine/files/__tests__/design-lock.test.ts apps/desktop/src/engine/git/__tests__/forge.test.ts apps/desktop/src/engine/git/__tests__/worktree.test.ts apps/desktop/src/engine/db/__tests__/migrations.test.ts apps/desktop/src/engine/workspace/__tests__/service.test.ts",
    "check:autonomous-foundation": "pnpm check:design-containment",
    "test:workspace-lifecycle": "vitest run --config vitest.config.ts apps/desktop/src/engine/git/__tests__/workspace-base-lifecycle.test.ts apps/desktop/src/engine/git/__tests__/branch-catalog.test.ts apps/desktop/src/engine/git/__tests__/branch.test.ts apps/desktop/src/engine/git/__tests__/default-branch-freshness.test.ts apps/desktop/src/engine/git/__tests__/watch.test.ts apps/desktop/src/engine/git/__tests__/cleanup.test.ts apps/desktop/src/engine/git/__tests__/worktree.test.ts apps/desktop/src/engine/git/__tests__/worktree-seed.test.ts apps/desktop/src/engine/git/__tests__/workspace-files.test.ts apps/desktop/src/engine/git/__tests__/cross-tool.test.ts apps/desktop/src/engine/git/__tests__/workspace-git-regressions.test.ts apps/desktop/src/engine/git/__tests__/repo-scripts.test.ts apps/desktop/src/engine/git/__tests__/git-exec.test.ts apps/desktop/src/engine/git/__tests__/engine-token-store.test.ts apps/desktop/src/engine/git/__tests__/github.test.ts apps/desktop/src/engine/git/__tests__/publish-github.test.ts apps/desktop/src/engine/git/__tests__/sync-workspace-pr.test.ts apps/desktop/src/engine/settings/__tests__/files.test.ts apps/desktop/src/engine/settings/__tests__/resolve.test.ts apps/desktop/src/engine/settings/__tests__/schema.test.ts apps/desktop/src/engine/workspace/__tests__/service.test.ts apps/desktop/src/engine/pty/__tests__/registry.test.ts apps/desktop/src/engine/pty/__tests__/service.test.ts apps/desktop/src/engine/agents/__tests__/gateway-end-session.test.ts apps/desktop/src/renderer/platform/bridge/__tests__/workspace-bridge.test.ts apps/desktop/src/renderer/platform/__tests__/workspace-operation-errors.test.ts apps/desktop/src/renderer/features/agent/__tests__/new-chat-defaults.test.ts apps/desktop/src/renderer/features/agent/__tests__/sessions-store-agent-exit.test.ts apps/desktop/src/renderer/features/agent/__tests__/sessions-store-detach.test.ts apps/desktop/src/renderer/shared/lib/__tests__/workspace-card-action.test.ts apps/desktop/src/renderer/features/repositories/__tests__/repo-branch-catalog-cache.test.ts apps/desktop/src/renderer/shell/workbench/__tests__/fresh-workspace.test.ts apps/desktop/src/renderer/state/__tests__/active-chat-per-workspace.test.ts apps/desktop/src/renderer/state/__tests__/archive-navigation.test.ts apps/desktop/src/renderer/state/__tests__/keyed-async-cache.test.ts apps/desktop/src/renderer/state/__tests__/live-workspace-selectors.test.ts apps/desktop/src/renderer/state/__tests__/pending-workspaces.test.ts apps/desktop/src/renderer/state/__tests__/workspace-cache-transitions.test.ts apps/desktop/src/renderer/state/__tests__/workspace-create-intents.test.ts apps/desktop/src/renderer/state/__tests__/workspace-list-persistence.test.ts apps/desktop/src/renderer/state/__tests__/workspace-resolution.test.ts apps/desktop/src/renderer/state/__tests__/chat-panes-store.test.ts apps/desktop/src/renderer/state/__tests__/chat-selection-invariant.test.ts",
    "lint": "eslint apps/desktop/src apps/desktop/electron",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:electron && pnpm typecheck:packages",
    "typecheck:app": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:electron": "tsc --noEmit -p apps/desktop/electron/tsconfig.typecheck.json",
    "typecheck:packages": "pnpm --filter @zeros/design-core run typecheck && pnpm --filter @zeros/design-web run typecheck && pnpm --filter @zeros/protocol run typecheck && pnpm --filter @zeros/marketing run typecheck",
    "schemas:build": "tsx scripts/build-settings-schemas.ts",
    "test:ui-smoke": "node scripts/ui-smoke-composer.mjs",
    "test:control-plane": "pnpm --dir apps/control-plane test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.238",
    "@anthropic-ai/sandbox-runtime": "0.0.73",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
