# Dependencies
node_modules/
.pnpm-debug.log*
package-lock.json
yarn.lock
# ...but the standalone Cloudflare Pages app DO commit its lockfile so CF can
# `npm ci` (reproducible Functions builds).
!website/web-app/package-lock.json
# Auth/registry config — can carry a real npm token. Never tracked.
.npmrc

# Build output
dist/
dist-engine/
dist-electron/
release/
binaries/
/lib/
*.tgz
out/
*.tsbuildinfo

# IDE / Editor
.vscode/
.idea/
.zed/
*.swp
*.swo
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables — every .env variant, at any depth, is machine-local.
# `.env.example` is the ONE exception: the templates are tracked on purpose
# (scripts/check-vite-env-sync.mjs reads .env.example to prove the VITE_* set
# is documented, and backend/README tells you to `cp .env.example .env`), so
# they are negated back in. The `.env.*` wildcard is what catches the variants
# an enumerated list keeps missing — .env.production, .env.development, .env.test.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Cloudflare Workers local secrets (`wrangler dev`) — plaintext service keys,
# must NEVER be committed. A `.dev.vars.example` template is exempted so one
# can be added later without fighting this rule.
**/.dev.vars
!**/.dev.vars.example

# Wrangler's local dev state/cache — every worker package, not just one.
**/.wrangler/

# Credentials / code-signing material. The macOS release path does Developer ID
# signing + notarization (electron-builder.yml documents CSC_LINK as a base64
# .p12), so the raw certificate and key formats must never land in the tree.
# scripts/check-secrets.mjs only scans tracked TEXT files — it cannot see a
# binary .p12, which makes this block the only guard.
*.p12
*.pfx
*.pem
*.p8
*.cer
*.keystore
*.mobileprovision
*.provisionprofile
id_rsa*
id_ed25519*

# Testing
coverage/
.nyc_output
test-results/
playwright-report/
blob-report/

# Temporary files
.tmp/
temp/
.turbo/
.eslintcache

# HTML plan/UI previews — temporary visualizations of plans before
# execution; created for preview and removed afterward. Never tracked.
HTML Previews/

# Zeros engine (generated at runtime)
.zeros/
.mcp.json

# Testing harness (local only)
testing/

# Bun build leftovers (build-sidecar runs in /tmp, but guard the repo root too)
*.bun-build

# Visual harness output (local captures)
snapshots/current/
snapshots/diff/

# Working notes. `docs/` is a local-only engineering journal: scratch analyses,
# audits and plans that are superseded as fast as they are written, so a public
# clone would only ever read a stale snapshot. Listed in `.worktreeinclude` so
# it still follows you into every new worktree — AGENTS.md and RULES.md send
# agents in there, and an empty `docs/` breaks them.
#
# `styles/Artifacts/` is deliberately NOT here: the design lab is tracked. It
# is a build-free tree of hand-written HTML served only by the vite dev
# middleware (vite.config.ts) and scripts/serve-loaders.mjs, never bundled into
# a production build, but it IS the design record and two of its files carry
# third-party licences (THIRD-PARTY-NOTICES.md).
/docs/

# website/ — sibling frontends vendored for Cloudflare Pages deploy (marketing + web-app)
# Same pattern: node_modules + dist + build + logs never tracked. (Env files are
# already covered by the global .env rules above.)
# website/web-app/dist is the unified Pages output (marketing assemble + static).
website/*/node_modules/
website/**/node_modules/
website/*/dist/
website/**/dist/
website/*/build/
website/**/build/
website/**/.cache/
website/**/*.log
website/*/tmp/
website/**/tmp/

# Claude Code runtime artifacts (locks, scheduled-task state)
.claude/

# External worktree-tool config. Machine/tool-local: its whole content is a
# third-party schema URL plus a setup command, so it is neither product source
# nor documentation and has no place in a public clone. Listed in
# `.worktreeinclude` so it still follows you into every new worktree.
.conductor/

# Agent-harness scratch: session transcripts, todo state and pasted attachments
# (screenshots, CSVs). User content, never repo content. This lived in
# .git/info/exclude for a long time, which does NOT travel with a clone —
# so every fresh clone was unprotected. It belongs here.
.context/

# Codex protocol codegen cache (sparse clone of openai/codex pinned
# to package.json#codexProtocolVersion). Holds the Rust workspace +
# cargo target dir — multi-GB, fully reproducible. The GENERATED TS
# output at src/engine/agents/adapters/codex/generated/ IS committed
# so machines without a Rust toolchain can still build.
.codex-protocol-cache/
