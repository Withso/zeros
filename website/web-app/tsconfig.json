{
  // Self-contained typecheck for the Cloudflare Pages Functions. NOT referenced
  // by the repo's root tsconfig.typecheck.json (`include: ["src"]`), so these
  // files never enter the desktop typecheck. Run `pnpm typecheck` here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": ["functions", "lib"]
}
