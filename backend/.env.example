# Zeros control plane — environment
# Copy to .env for local dev (tsx loads nothing automatically; use
# `env $(cat .env | xargs) pnpm dev` or a launcher of your choice).

# Railway Postgres connection string (private-network URL in production).
DATABASE_URL=postgres://user:password@localhost:5432/zeros

# The Auth0 tenant domain (no scheme). JWKS + issuer are derived from it.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Auth0 API identifier registered for this backend (Auth0 requires an
# explicit audience; there is no implicit default).
AUTH_AUDIENCE=https://api.zeros.build

# Optional overrides (defaults derived from AUTH0_DOMAIN):
# AUTH_ISSUER=https://your-tenant.us.auth0.com/,https://api.zeros.build/   (comma-separated; list both if a custom Auth0 domain is added later)
# AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

PORT=8080

# ── Invitation email — ZeptoMail (Zoho) HTTP API ────
# Unset → dev fallback: emails are logged, not sent; the invite's
# copyable accept link still works.
# ZEPTOMAIL_TOKEN=            (ZeptoMail Mail Agent → SMTP/API → API tab → Send Mail Token)
# EMAIL_FROM=Zeros <hello@zeros.build>   (any address on the verified zeros.build domain)
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email   (default; tokens are region-bound — the host must match the account's region)
# INVITE_LINK_BASE=https://app.zeros.build/invite
