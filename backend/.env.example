# Zeros control plane — environment
# Copy to .env for local dev (tsx loads nothing automatically; use
# `env $(cat .env | xargs) pnpm dev` or a launcher of your choice).

# Railway Postgres connection string (private-network URL in production).
DATABASE_URL=postgres://user:password@localhost:5432/zeros

# The Auth0 tenant domain (no scheme). JWKS + issuer are derived from it.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Auth0 API identifier registered for this backend (Auth0 requires an
# explicit audience; there is no implicit default).
AUTH_AUDIENCE=https://api.zeros.build

# ── GitHub App — OPTIONAL, one distinct registration per environment ─────
# Leave this whole block unset until an App is registered: GitHub sign-in is
# then simply off (/v1/github/* answers 503 github_not_configured, and the
# desktop tells the user to use gh CLI or a PAT). Every other control-plane
# feature works either way. Supplying only SOME of the five required values
# logs a loud error and still disables only GitHub — it never fails boot.
#
# Public identifiers:
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.example
# GITHUB_APP_SLUG=zeros-dev

# Backend secret store only. Never ship this value in the desktop bundle:
# GITHUB_APP_CLIENT_SECRET=replace-with-github-app-client-secret

# Must exactly match one callback URL registered on the GitHub App:
# GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8080/v1/github/oauth/callback

# HMAC key for the refresh-token binding. Defaults to the client secret, which
# is fine until you rotate that secret — bindings signed with the old value stop
# verifying, and every desktop is asked to reconnect. Set it separately (any
# random 32+ byte string) in every environment you intend to rotate.
# GITHUB_REFRESH_BINDING_SECRET=

# Defaults shown; override only for a separately-registered GHES variant:
# GITHUB_WEB_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com

# Optional overrides (defaults derived from AUTH0_DOMAIN):
# AUTH_ISSUER=https://your-tenant.us.auth0.com/,https://api.zeros.build/   (comma-separated; list both if a custom Auth0 domain is added later)
# AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

PORT=8080

# ── Invitation email — ZeptoMail (Zoho) HTTP API ────
# Unset → dev fallback: emails are logged, not sent; the invite's
# copyable accept link still works.
# ZEPTOMAIL_TOKEN=            (ZeptoMail Mail Agent → SMTP/API → API tab → Send Mail Token)
# EMAIL_FROM=Zeros <hello@zeros.build>   (any address on the verified zeros.build domain)
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email   (default; tokens are region-bound — the host must match the account's region)
# INVITE_LINK_BASE=https://app.zeros.build/invite
