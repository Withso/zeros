# Zeros operator fixture credentials: template for .env.agent
#
# Development agents do not use this file. They reach Alpha providers through
# the Zeros Internal MCP: call `whoami`, then the `check_*` tools. See
# apps/control-plane/INTERNAL-OPS.md to connect a client.
#
# Operators only: gate0 (`pnpm alpha:probe`), the Alpha rehearsal
# (`pnpm alpha:rehearse`), local fixture seeding and the native Alpha check
# read these fields in memory. Keep the file in a trusted checkout. New
# worktrees never receive it: setup refuses a copied file, so import it
# deliberately with `node scripts/dev-environment/agent-env.mjs import <file>`.
# The ZEROS_DEV_* identity fields are moving to the `fixture` block of the
# private ~/.zeros-dev profile.
#
# - Alpha and test credentials only. Never add Production keys.
# - Scope each key to what the run needs, and let it expire within 90 days.
# - Keep each value on one line; base64-encode multi-line keys such as PEM files.
# - Never name a GitHub token GH_TOKEN or GITHUB_TOKEN: that overrides
#   Conductor's gh login.
#
# Verify with `pnpm agent:check`. It only reads, and it never prints values.

# Alpha test account: gate0, rehearsal and local fixture seeding. Owner-provided
# dedicated test password; never pass it as a CLI argument.
ZEROS_DEV_PASSWORD=
ZEROS_DEV_WORKOS_SUBJECT=
ZEROS_DEV_ACCOUNT_ID=
ZEROS_DEV_EMAIL=
ZEROS_DEV_ORGANIZATION_ID=
# electron:cloud needs owner/repository and the numeric GitHub installation ID.
# Hosted zeros-dev also needs its identity above and numeric repository ID;
# its installation ID is the Zeros UUID, not GitHub's numeric ID.
ZEROS_DEV_REPOSITORY=
ZEROS_DEV_REPOSITORY_ID=
ZEROS_DEV_GITHUB_INSTALLATION_ID=

# `pnpm alpha:probe`: the Alpha test organization (slug or UUID) the probe may
# create workspaces in; never a real team organization. Optional repository
# override and VM rate (USD per hour) for the report's cost estimate.
ZEROS_ALPHA_PROBE_ORGANIZATION=
ZEROS_ALPHA_PROBE_REPOSITORY=
ZEROS_ALPHA_PROBE_VM_DOLLARS_PER_HOUR=

# `pnpm alpha:rehearse`: the agent turns. Setup connects the first one set for
# the test account, as Settings does, and cleanup removes and revokes it.
# Test-account credentials only.
ZEROS_REHEARSAL_CLAUDE_SETUP_TOKEN=
ZEROS_REHEARSAL_CLAUDE_API_KEY=
ZEROS_REHEARSAL_OPENAI_API_KEY=
ZEROS_REHEARSAL_CURSOR_API_KEY=

# `pnpm alpha:rehearse` against Alpha: the Alpha GitHub App (never the
# Production app's key), the Alpha database and the Alpha bucket.
# ZEROS_GITHUB_ALPHA_APP_PRIVATE_KEY_B64: base64 -i key.pem | tr -d '\n'
ZEROS_GITHUB_ALPHA_APP_ID=
ZEROS_GITHUB_ALPHA_APP_PRIVATE_KEY_B64=
# PlanetScale service token for the Alpha database only: read_database and
# read_branch for `pnpm agent:check`. Operator release migrations also need
# read_backups, write_backups, connect_production_branch,
# create_production_branch_password and delete_production_branch_password.
# Without create_production_branch_password, PlanetScale refuses the migration
# role (HTTP 403).
PLANETSCALE_ORG=
ZEROS_PLANETSCALE_ALPHA_DATABASE=zeros-control-plane-alpha
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_SERVICE_TOKEN=
# R2 token with Object Read & Write on the Alpha bucket only. The S3 access key
# ID is the token ID; the secret is the SHA-256 of the token value.
ZEROS_R2_ALPHA_BUCKET=zeros-cloud-workspaces-alpha
ZEROS_R2_ALPHA_ENDPOINT=
ZEROS_R2_ALPHA_ACCESS_KEY_ID=
ZEROS_R2_ALPHA_SECRET_ACCESS_KEY=

# Native Alpha check cleanup: revokes a session a run left. A dedicated Alpha
# WorkOS key, separate from the key the Alpha control plane uses.
WORKOS_ALPHA_API_KEY=

# Optional: agent credentials local fixture seeding connects for the test
# organization. These spend money.
CLAUDE_CODE_OAUTH_TOKEN=
CURSOR_API_KEY=
OPENAI_API_KEY=
