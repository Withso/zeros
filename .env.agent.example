# Zeros agent credentials: template for .env.agent
#
# Copy to .env.agent at the repository root (gitignored) and run
# `chmod 600 .env.agent`. Conductor copies .env.agent into every new workspace,
# so agents can build and test against Alpha without re-entering keys.
#
# - Alpha and test credentials only. Never add Beta or Production keys.
# - Scope each key to what agents need, and let it expire within 90 days.
# - Keep each value on one line; base64-encode multi-line keys such as PEM files.
# - Never name a GitHub token GH_TOKEN or GITHUB_TOKEN: that overrides
#   Conductor's gh login.
#
# Verify with `pnpm agent:check`. It only reads, and it never prints values.

# Cloudflare: token with Pages Read, Workers R2 Storage Read, and Zone Read and
# DNS Read on zeros.build.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2: token with Object Read & Write on the Alpha bucket only. The S3
# access key ID is the token ID; the secret is the SHA-256 of the token value.
ZEROS_R2_ALPHA_BUCKET=zeros-cloud-workspaces-alpha
ZEROS_R2_ALPHA_ENDPOINT=
ZEROS_R2_ALPHA_ACCESS_KEY_ID=
ZEROS_R2_ALPHA_SECRET_ACCESS_KEY=

# PlanetScale: service token with access to the Alpha database only. Copy both
# its ID and its value. `pnpm agent:check` needs read_database and read_branch.
# Release migrations also need read_backups, write_backups,
# connect_production_branch, create_production_branch_password and
# delete_production_branch_password. Without create_production_branch_password,
# PlanetScale refuses the migration role (HTTP 403).
PLANETSCALE_ORG=
ZEROS_PLANETSCALE_ALPHA_DATABASE=zeros-control-plane-alpha
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_SERVICE_TOKEN=

# Boat: scoped key without account admin.
BOAT_API_KEY=
BOAT_BILLING_ORG=

# Railway: project token for the alpha environment.
RAILWAY_ALPHA_PROJECT_TOKEN=

# WorkOS: a dedicated API key in the Alpha environment, separate from the key
# the Alpha control plane uses.
WORKOS_ALPHA_API_KEY=

# GitHub App for Alpha testing. Never the Production app's key.
# ZEROS_GITHUB_ALPHA_APP_PRIVATE_KEY_B64: base64 -i key.pem | tr -d '\n'
ZEROS_GITHUB_ALPHA_APP_ID=
ZEROS_GITHUB_ALPHA_APP_SLUG=zeros-alpha
ZEROS_GITHUB_ALPHA_APP_PRIVATE_KEY_B64=

# Optional: fine-grained token for Withso/zeros with Actions, Environments,
# Secrets and Variables read/write, for managing CI settings.
ZEROS_GITHUB_CI_TOKEN=

# Optional: live agent tests. These spend money.
CLAUDE_CODE_OAUTH_TOKEN=
CURSOR_API_KEY=
OPENAI_API_KEY=
ZEROS_CLOUD_REQUIRED_AGENTS=
ZEROS_CLOUD_AGENT_SELECTIONS=

# zeros-dev uses one canonical, mode-0600 .env.agent shared by all checkouts.
# Owner-provided dedicated Alpha test password; never pass it as a CLI argument.
# Session tokens and device key are written only by the locked zeros-dev login.
ZEROS_DEV_PASSWORD=
ZEROS_DEV_WORKOS_SUBJECT=
ZEROS_DEV_ACCOUNT_ID=
ZEROS_DEV_EMAIL=
ZEROS_DEV_ORGANIZATION_ID=
# cloud:local needs owner/repository and the numeric GitHub installation ID.
# Hosted zeros-dev also needs its identity above and numeric repository ID;
# its installation ID is the Zeros UUID, not GitHub's numeric ID.
ZEROS_DEV_REPOSITORY=
ZEROS_DEV_REPOSITORY_ID=
ZEROS_DEV_GITHUB_INSTALLATION_ID=
ZEROS_DEV_ACCESS_TOKEN=
ZEROS_DEV_REFRESH_TOKEN=
ZEROS_DEV_SESSION_ID=
ZEROS_DEV_TOKEN_EXPIRES_AT=
ZEROS_DEV_DEVICE_PRIVATE_KEY_B64=
# Optional independently provisioned Alpha read-only SQL login. No writes.
ZEROS_DEV_ALPHA_READONLY_DATABASE_URL=
