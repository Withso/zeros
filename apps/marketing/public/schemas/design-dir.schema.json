{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zeros.build/schemas/design-dir.schema.json",
  "title": "Zeros Design directory registry",
  "description": "Legacy central Design directory registry. New Design folders carry their own design.toml manifest with stable identity and document metadata. Entries must remain unique and non-overlapping during migration.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "directories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^design_[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "directories"
  ],
  "additionalProperties": false
}
