{
  // Self-contained typecheck for the Cloudflare Pages Functions. The web hub is
  // outside the root pnpm/TypeScript graph, so run `npm run typecheck` here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": ["functions", "lib", "session-worker"]
}
