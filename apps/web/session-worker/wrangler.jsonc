{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zeros-auth-sessions-local",
  "main": "worker.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_SESSIONS",
        "class_name": "AuthSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthSession"]
    }
  ],
  "env": {
    "alpha": {
      "name": "zeros-auth-sessions-alpha",
      "vars": {
        "APP_ORIGIN": "https://app-alpha.zeros.build"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_SESSIONS",
            "class_name": "AuthSession"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthSession"]
        }
      ]
    },
    "beta": {
      "name": "zeros-auth-sessions-beta",
      "vars": {
        "APP_ORIGIN": "https://app-beta.zeros.build"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_SESSIONS",
            "class_name": "AuthSession"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthSession"]
        }
      ]
    },
    "production": {
      "name": "zeros-auth-sessions-production",
      "vars": {
        "APP_ORIGIN": "https://app.zeros.build"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_SESSIONS",
            "class_name": "AuthSession"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthSession"]
        }
      ]
    }
  }
}
