# Security headers for app.zeros.build static responses.
#
# NOTE: The unified zeros-web project also serves zeros.build (marketing) from
# the same deployment. Per-host CSP is applied in functions/_middleware.ts
# (marketing needs Google Fonts; app keeps the strict policy below).
# These /* headers remain as a belt-and-suspenders default for static assets
# on the app host; middleware overwrites Content-Security-Policy per host.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# Dashboard and Ops assets intentionally use stable filenames. This is the
# static-route fallback. `_routes.json` deliberately invokes Pages Functions
# for these paths, where lib/hosts.ts applies the authoritative runtime policy
# because Cloudflare does not apply `_headers` to Functions responses.
# Revisioned URLs also evict responses cached before the runtime policy shipped.
/account-deletion.js
  Cache-Control: no-cache

/dashboard.js
  Cache-Control: no-cache

/dashboard.css
  Cache-Control: no-cache

/dashboard-tokens.css
  Cache-Control: no-cache

/ops.js
  Cache-Control: no-cache

/ops.css
  Cache-Control: no-cache

/zeros-deployment.json
  Cache-Control: no-store
