{
  "name": "@zeros/control-plane",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Zeros control plane for identity, organizations, teams, feedback, invitations, audit, and optional GitHub App coordination.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke:chat-titles": "tsx src/chat-titles-smoke.ts",
    "cloud-v2:publish-runtime": "tsx src/cloud/publish-runtime.ts",
    "auth:probe": "tsx src/auth-contract-probe.ts",
    "cloud-entitlement:manage": "tsx src/manage-cloud-workspace-entitlement.ts",
    "account-pro:manage": "tsx src/manage-account-pro.ts",
    "workos-erasure:manage": "tsx src/manage-workos-provider-erasure.ts",
    "staff:manage": "tsx src/manage-staff.ts",
    "reset:database": "tsx src/reset-database.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "release-migration:manage": "tsx src/manage-release-migration.ts",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@hono/node-server": "^2.1.0",
    "@openai/codex": "0.154.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@workos-inc/node": "10.12.0",
    "hono": "^4.13.11",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "ws": "8.21.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "8.18.1",
    "@workos/emulate": "0.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
