{
  "name": "@zeros/control-plane",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Zeros control plane for identity, organizations, teams, feedback, invitations, audit, and optional GitHub App coordination.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "auth:probe": "tsx src/auth-contract-probe.ts",
    "cloud-entitlement:manage": "tsx src/manage-cloud-workspace-entitlement.ts",
    "cloud-quota:manage": "tsx src/manage-cloud-workspace-quota.ts",
    "cloud-object-storage:manage": "tsx src/manage-cloud-workspace-object-storage.ts",
    "cloud-object-rotation:retry": "tsx src/manage-cloud-workspace-object-rotation.ts",
    "workos-erasure:manage": "tsx src/manage-workos-provider-erasure.ts",
    "staff:manage": "tsx src/manage-staff.ts",
    "reset:database": "tsx src/reset-database.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@daytona/api-client": "0.190.1",
    "@daytona/toolbox-api-client": "0.190.1",
    "@hono/node-server": "^2.1.0",
    "@workos-inc/node": "10.12.0",
    "hono": "^4.13.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@workos/emulate": "0.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
