# Zeros control plane — environment
# Copy to .env for local dev. Load through a dotenv-aware launcher; never
# evaluate secret files as shell commands.

# Runtime connection. Hosted Postgres requires verified TLS (sslmode=verify-full).
DATABASE_URL=postgres://user:password@localhost:5432/zeros
# DATABASE_URL must use a direct primary connection: WorkOS owns session locks
# across HTTP and SQL work. A dedicated listener alone does not make PgBouncer
# safe. PlanetScale requires port 5432 and sslmode=verify-full; do not copy
# libpq's sslrootcert=system into this Node driver URL.
# Optional dedicated durable-event wakeups pool, max 1, using runtime privileges.
# DATABASE_LISTEN_URL=postgres://user:password@primary.test:5432/zeros
# Separate direct-primary credentials for the one-shot migrator. Leave unset
# only for legacy/local deployments that use one login for both authorities.
# DATABASE_MIGRATION_URL=postgres://migrator:password@localhost:5432/zeros
# After provisioning the schema, disable DDL at API boot. The API then verifies
# migration checksums using DATABASE_URL and fails closed if anything is pending.
# Keep migration credentials in the migration job, not the API service.
DATABASE_MIGRATIONS_ON_BOOT=true
# Cutover fence: only GET/HEAD /healthz is served. All application routes,
# upgrades, background workers and boot migrations are disabled. This can boot
# against the old schema for a final quiescent backup; it does not verify that
# schema. Normal verify-only boot is still required before opening the target.
DATABASE_MAINTENANCE_MODE=false
# Request-pool ceiling. Without DATABASE_LISTEN_URL it also holds the listener;
# with a separate listener budget one extra direct connection per process.
# Multiply by replicas/rolling overlap and reserve migration/operator headroom.
# Minimum 3 with the shared listener, or 2 with a dedicated listener. Start a
# PS-5 deployment at 6 runtime + 1 listener, then qualify measured load/overlap.
DATABASE_POOL_MAX=10

# Requests at least this slow (ms, 50-60000) are logged once by route template,
# with shared-transaction count, time and pool wait. Never logs raw paths.
SLOW_REQUEST_LOG_MS=1000
# Optional automatic chat names. Server-only OpenAI project/service-account key.
# Never put this in VITE_*, the desktop bundle, or a user's provider settings.
# Unset disables automatic naming; existing and manually entered titles work.
# CHAT_TITLE_OPENAI_API_KEY=replace-with-openai-server-key
# One operator mailbox for aggregate cloud health alerts (sent through Resend;
# needs RESEND_API_KEY and EMAIL_FROM). Unset disables alerts.
# OPERATIONS_ALERT_EMAIL=ops@example.com

# Select the active access-token issuer. Keep auth0 until the web and desktop
# clients have completed their staged WorkOS cutover.
AUTH_PROVIDER=auth0

# Expected access-token audience for this control plane.
AUTH_AUDIENCE=https://api.zeros.build

# Legacy Auth0 mode. The issuer and JWKS URL are derived from this domain unless
# both explicit provider-neutral overrides below are set.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# WorkOS mode makes this Railway service the browser-session and management
# boundary. Multiple Applications share the environment/default Application's
# exact issuer while `client_id` distinguishes web from desktop tokens. Keep
# those client IDs distinct, use the environment/default Application's signing
# JWKS, and do not infer a trailing slash or substitute the desktop client in
# either verification URL.
# AUTH_PROVIDER=workos
# APP_ORIGIN=https://app.zeros.build
# AUTH_ISSUER=https://api.workos.com/user_management/client_example_web
# AUTH_JWKS_URL=https://api.workos.com/sso/jwks/client_example_web
# AUTH_WEB_CLIENT_ID=client_example_web
# AUTH_DESKTOP_CLIENT_ID=client_example_desktop
# Railway secrets; never copy these into Pages, GitHub build variables, the
# desktop, command arguments, logs, or repository files.
# WORKOS_API_KEY=replace-with-channel-server-key
# WORKOS_COOKIE_PASSWORD=replace-with-unique-random-32-byte-or-longer-value
# WORKOS_WEBHOOK_SECRET=replace-with-channel-endpoint-signing-secret

# Public Railway templates only: opt out of the official Zeros
# alpha/beta/production domain and branch matrix. Leave unset for Zeros-hosted
# deployments. Template installers must supply their own WorkOS environment;
# APP_ORIGIN must remain separate from the AUTH_AUDIENCE/API origin.
# ZEROS_SELF_HOSTED=true

# ── GitHub App — OPTIONAL, one distinct registration per environment ─────
# Leave this whole block unset until an App is registered: GitHub sign-in is
# then simply off (/v1/github/* answers 503 github_not_configured, and the
# desktop tells the user to use gh CLI or a PAT). Every other control-plane
# feature works either way. Supplying only SOME of the five required values
# logs a loud error and still disables only GitHub — it never fails boot.
#
# Public identifiers:
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.example
# GITHUB_APP_SLUG=zeros-dev

# Backend secret store only. Never ship this value in the desktop bundle:
# GITHUB_APP_CLIENT_SECRET=replace-with-github-app-client-secret
# Optional until cloud workspaces are enabled. The PEM RSA private key lets the
# coordinator mint one-hour installation tokens; use literal \n in single-line
# secret stores. It never ships to a desktop or workspace.
# GITHUB_APP_PRIVATE_KEY=<github-app-private-key-pem-with-newlines-escaped>

# Must exactly match one callback URL registered on the GitHub App:
# GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8080/v1/github/oauth/callback

# Browser confirmation page. Override for preview/local end-to-end testing;
# production defaults to https://app.zeros.build/github/connected.
# GITHUB_COMPLETION_PAGE_URL=http://127.0.0.1:8788/github/connected

# HMAC key for the refresh-token binding. Defaults to the client secret, which
# is fine until you rotate that secret — bindings signed with the old value stop
# verifying, and every desktop is asked to reconnect. Set it separately (any
# random 32+ byte string) in every environment you intend to rotate.
# GITHUB_REFRESH_BINDING_SECRET=

# Defaults shown; override only for a separately-registered GHES variant:
# GITHUB_WEB_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com

# ── Cloud workspaces — EXPLICITLY GATED, PRE-PRODUCTION ───────────────
# Paid provider resources are never enabled merely by setting credentials.
# Keep this false until a quota row has been provisioned for each approved
# Organization and the environment has passed the protected provider runbook.
CLOUD_WORKSPACES_ENABLED=false

# Required together only when CLOUD_WORKSPACES_ENABLED=true. The GitHub App
# block above must also include a valid RSA GITHUB_APP_PRIVATE_KEY.
# Managed Boat Linux VMs are the default provider. Qualify the exact
# source/image before selecting these values.
# CLOUD_WORKSPACE_PROVIDER=boat
# BOAT_API_KEY=replace-with-backend-only-boat-key
# BOAT_ACCOUNT_SCOPE=stable-identifier-for-this-provider-account
# Boat organization wallet (team_...) billed for every new sandbox. Never rely
# on the account's dashboard-selected wallet.
# BOAT_BILLING_ORG=team_00000000-0000-4000-8000-000000000000
# BOAT_SNAPSHOT_ID=immutable-qualified-snapshot-name
# BOAT_IMAGE_BUILD_SHA256=qualified-64-character-build-metadata-sha256
# BOAT_TTL_SECONDS=900
# BOAT_COMPUTE_POLICY_ID=reviewed-price-policy-v1
# BOAT_SECONDS_PER_DOLLAR=replace-with-confirmed-integer-rate
#
# Optional managed Daytona compatibility deployment instead of Boat. Daytona
# must be selected explicitly; its worker isolation is not yet qualified.
# CLOUD_WORKSPACE_PROVIDER=daytona
# DAYTONA_API_KEY=replace-with-backend-only-daytona-key
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=eu
# DAYTONA_SNAPSHOT_ID=immutable-qualified-snapshot-id
# DAYTONA_SANDBOX_CLASS=linux-vm # Explicitly qualified region and VM quota required.
# ZEROS_CLOUD_IMAGE_ARCHITECTURE=linux/amd64
# ZEROS_CLOUD_SOURCE_COMMIT=0123456789abcdef0123456789abcdef01234567

# Pinned generation resources. These values are recorded durably, charged
# against Organization quotas, and sent exactly to the provider.
# CLOUD_WORKSPACE_CPU_MILLICORES=4000
# CLOUD_WORKSPACE_MEMORY_MIB=8192
# CLOUD_WORKSPACE_STORAGE_MIB=40960
# CLOUD_WORKSPACE_OPERATION_TIMEOUT_SECONDS=180
# CLOUD_WORKSPACE_AUTO_ARCHIVE_MINUTES=10080
# CLOUD_WORKSPACE_RECONCILE_INTERVAL_MS=5000
# Managed Boat additionally needs an explicit operator compute-credit grant
# for the owning Organization member before create/resume. The rate above is
# not a grant or an entitlement. See docs/cloud-workspace/compute-credits.md.
#
# Customer Daytona alongside managed Boat, with its own qualified image size.
# No hosted DAYTONA_API_KEY is needed for these user-provided connections.
# DAYTONA_BYO_ENABLED=true
# DAYTONA_BYO_SNAPSHOT_ID=immutable-qualified-daytona-snapshot-id
# DAYTONA_BYO_SANDBOX_CLASS=linux-vm # Pinned per generation; omission retains legacy containers.
# DAYTONA_BYO_SOURCE_COMMIT=0123456789abcdef0123456789abcdef01234567
# DAYTONA_BYO_ARCHITECTURE=linux/amd64
# DAYTONA_BYO_CPU_MILLICORES=2000
# DAYTONA_BYO_MEMORY_MIB=4096
# DAYTONA_BYO_STORAGE_MIB=40960
# Credential onboarding may be enabled separately for API qualification before
# a Daytona compute image is qualified. This permits read-only key validation;
# it does not register a provisioning profile or enable VM allocation.
# DAYTONA_CONNECTIONS_ENABLED=true
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Optional until a user-owned Daytona connection is configured. This key is
# coordinator-only and encrypts delegated provider credentials at rest; it is
# never sent to the sandbox. Exactly 32 random bytes, canonical base64url.
# CLOUD_WORKSPACE_PROVIDER_CREDENTIAL_KEY_V1=replace-with-43-character-base64url

# Provider access responses are accepted only for these exact DNS boundaries.
# Override both for a self-hosted Daytona deployment; never use wildcards.
# DAYTONA_SSH_HOSTS=ssh.app.daytona.io
# DAYTONA_PREVIEW_HOST_SUFFIXES=proxy.daytona.work
# Optional, but required to enable authenticated browser previews. Configure
# wildcard DNS and TLS for *.cloud-preview.example.com to this service. Each
# grant receives an isolated origin; do not reuse the control-plane API origin.
# CLOUD_WORKSPACE_PREVIEW_BASE_DOMAIN=cloud-preview.example.com

# Setup execution has a separate operator gate. With provisioning enabled and
# this false, newly created resources remain honestly at `setting_up`; no
# repository credential or setup command enters the sandbox. Enable only after
# every enabled provider image has passed the protected live qualification.
CLOUD_WORKSPACE_SETUP_WORKER_ENABLED=false

# Per-process worker role. False serves cloud APIs without starting cloud
# reconciliation, setup, invitation, outbox, checkpoint, or maintenance loops.
# Real execution needs a separately enabled worker replica. This does not
# disable provider calls made by explicitly invoked API operations.
CLOUD_WORKSPACE_BACKGROUND_WORKERS_ENABLED=true

# Durable object storage is independent from sandbox setup. Configure an
# adapter and an encryption key before fork/export/recovery/replica APIs.
# The key is exactly 32 random bytes as canonical, unpadded base64url.
# For a filesystem adapter, mount a persistent volume at /data, then
# use a dedicated mode-0700 child owned by the sole control-plane runtime. Do
# not use the mount root or attach replicas/other writers to this filesystem.
# CLOUD_WORKSPACE_OBJECT_KEY_V1=replace-with-43-character-base64url
# CLOUD_WORKSPACE_OBJECT_STORE_KIND=filesystem
# CLOUD_WORKSPACE_OBJECT_STORE_DIRECTORY=/data/zeros-workspace-objects
# For shared private S3-compatible storage, omit OBJECT_STORE_DIRECTORY.
# The endpoint is the HTTPS service origin, WITHOUT a bucket/path/query.
# Bucket-scoped credentials need GetObject, HeadObject and PutObject.
# Conditional writes and strong read-after-write are required. Never expire or
# delete the adapter's zero-byte deletion fences with a lifecycle rule.
# CLOUD_WORKSPACE_OBJECT_STORE_KIND=s3
# CLOUD_WORKSPACE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# CLOUD_WORKSPACE_S3_REGION=auto
# CLOUD_WORKSPACE_S3_BUCKET=zeros-workspace-objects-alpha
# CLOUD_WORKSPACE_S3_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
# CLOUD_WORKSPACE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# During rotation, provide every still-readable version as a JSON object and
# select the version used for new writes. Never remove an old key until its
# rotation jobs and restore drill have completed. Rotation deletes superseded
# ciphertext, so a point-in-time restore to before it finished cannot read the
# blobs rotated after that point (see the README's object restore window).
# CLOUD_WORKSPACE_OBJECT_KEYS_JSON={"1":"old-key","2":"new-key"}
# CLOUD_WORKSPACE_OBJECT_CURRENT_KEY_VERSION=2
# Live objects outlive their last reference this long, so a point-in-time
# database restore still finds them (0-720; match the database's backup
# retention, 48 hours on PlanetScale).
# CLOUD_WORKSPACE_OBJECT_RESTORE_WINDOW_HOURS=48
# The mounted volume's provider quota is an infrastructure ceiling, not an
# admission policy. Provision each Organization's separate durable byte limits
# with `cloud-object-storage:manage` before accepting object writes, and retain
# operational headroom above the sum of application limits.

# Coordinator-only envelope keys for secret bindings and one-use setup
# material. V1 alone remains a compatible single-key configuration. For
# rotation, deploy the complete readable keyring and select the version used
# for new binding versions and newly sealed setup material.
# CLOUD_WORKSPACE_SECRET_KEY_V1=replace-with-43-character-base64url
# CLOUD_WORKSPACE_SECRET_KEYS_JSON={"1":"old-key","2":"new-key"}
# CLOUD_WORKSPACE_SECRET_CURRENT_KEY_VERSION=2
# Optional native Codex subscription renewal: dedicated security-fingerprint keys.
# Keep all registered versions; these are independent from encryption keys.
# CLOUD_CODEX_REFRESH_FINGERPRINT_KEYS_JSON={"1":"replace-with-43-character-base64url"}
# CLOUD_CODEX_REFRESH_FINGERPRINT_CURRENT_KEY_VERSION=1
# Keep every referenced version available through binding rotation, generation
# replacement, setup-material expiry, and the applicable backup-retention
# window. These keys are independent from CLOUD_WORKSPACE_OBJECT_KEYS_JSON.

# Optional signed transactional-outbox consumer for billing, analytics, or a
# customer-managed integration. Leave both unset to retain events durably in
# Postgres without acknowledging delivery. The receiver must deduplicate by
# x-zeros-idempotency-key and verify x-zeros-signature-v1 over the exact body.
# CLOUD_WORKSPACE_OUTBOX_URL=https://events.example.com/v1/cloud-workspaces
# CLOUD_WORKSPACE_OUTBOX_SIGNING_SECRET=replace-with-random-32-byte-or-longer-value
# CLOUD_WORKSPACE_OUTBOX_TIMEOUT_MS=10000

# Required together only when CLOUD_WORKSPACE_SETUP_WORKER_ENABLED=true.
# CLOUD_WORKSPACE_CONTROL_PLANE_URL=https://api-alpha.zeros.build
# DAYTONA_TOOLBOX_ORIGINS=https://proxy.app.daytona.io
# Omit to use PROTOCOL_VERSION from packages/protocol/src/version.ts (the
# qualified image default). Set only for a separately qualified older image
# whose version remains within the advertised compatibility range.
# CLOUD_WORKSPACE_ENGINE_PROTOCOL_VERSION=<qualified-compatible-version>

# Bounded worker/engine defaults. Override only from measured provider runs.
# CLOUD_WORKSPACE_ENGINE_PORT=39393
# Engine heartbeat cadence (5000-30000). Stop, archive and rebuild wait up to
# one interval for their checkpoint directive; each beat is one transaction.
# CLOUD_WORKSPACE_ENGINE_HEARTBEAT_INTERVAL_MS=10000
# CLOUD_WORKSPACE_SETUP_INTERVAL_MS=1000
# CLOUD_WORKSPACE_SETUP_TIMEOUT_SECONDS=1800
# CLOUD_WORKSPACE_SETUP_LEASE_MS=60000
# CLOUD_WORKSPACE_SETUP_ADMISSION_TTL_SECONDS=120

# Optional explicit Auth0 overrides (both are required when AUTH0_DOMAIN is
# omitted; AUTH_ISSUER may remain comma-separated only in Auth0 mode):
# AUTH_ISSUER=https://your-tenant.us.auth0.com/
# AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

PORT=8080

# ── Optional Zeros product/security email — Resend HTTPS API ───────
# WorkOS mode uses WorkOS's native invitation email and does not send a
# duplicate through Resend. These values remain available for durable
# Zeros-specific security notifications and the Auth0 rollback invitation.
# Unset → dev fallback: Zeros-owned messages are logged, not sent.
# Use one sending-only, domain-restricted key per deployment channel.
# RESEND_API_KEY=
# EMAIL_FROM=Zeros <notifications@updates.zeros.build>
# Replies are routed to hi@zeros.build independently of the verified sender.
# INVITE_LINK_BASE=https://app.zeros.build/invite

# ── Feedback — OPTIONAL destinations; configure at least one per shipped env ─
# Feedback is authenticated at POST /v1/feedback and fan-outs independently.
# It succeeds when either configured destination accepts the report.
# These are backend-only Railway variables. Never expose them as VITE_* values.

# Intercom (Developer Hub access token). Region: us (default), eu, or au.
# INTERCOM_TOKEN=
# INTERCOM_REGION=us
# INTERCOM_ADMIN_ID=
# Provider IDs for: Bug or Issue, Feedback, Feature Request.
# INTERCOM_TAG_IDS={"bug":"tag-id","feedback":"tag-id","feature":"tag-id"}
# INTERCOM_APP_ID=

# Linear (personal/API key plus destination team). Full scrubbed logs are
# uploaded as a private .jsonl asset; upload failure falls back to an inline tail.
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# Provider IDs for: Bug or Issue, Feedback, Feature Request.
# LINEAR_LABEL_IDS={"bug":"label-id","feedback":"label-id","feature":"label-id"}

# Optional base used to link a PostHog distinct id from a report.
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/123

# One-time only. A production-mode migration marked as requiring controlled
# downtime will refuse to run unless its exact filename is listed. Use this on
# the explicit one-off migration command, remove it afterward, and never set it
# on the web service: production service boot deliberately ignores approvals.
# Run `node dist/migrate.js --plan` with the migration connection first to read
# this artifact's pending filenames without applying DDL. Every pending
# controlled boundary must be approved before the explicit migration starts.
# Follow the boundary-specific drain, backup, and reconciliation checks in
# docs/cloud-workspace/infrastructure-and-operations.md; disabled cloud flags
# alone do not make the later compute, security, or individual-Pro boundaries safe.
# CONTROL_PLANE_MIGRATION_APPROVALS=0009_organization_team_hierarchy.sql,0025_cloud_workspace_engine_authority.sql,0060_cloud_workspace_pending_blob_deletions.sql,0061_workos_provider_erasure_fences.sql,0073_cloud_workspace_compute_leases.sql,0075_security_event_commit_order.sql,0076_cloud_workspace_individual_pro_and_pilot.sql,0079_cloud_workspace_user_compute_funding.sql
