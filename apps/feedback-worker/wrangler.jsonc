{
  // Standalone Cloudflare Worker — deployed SEPARATELY from the desktop app's
  // build. Reachable at its workers.dev URL by default; that URL goes into the
  // app's VITE_FEEDBACK_URL (renderer posts feedback to it).
  //
  //   Deploy: from apps/feedback-worker → `npx wrangler@4 deploy`
  //           (NOT `pnpm deploy` — pnpm built-in; use `pnpm run deploy` for the script)
  //   Logs:   `npx wrangler@4 tail`
  //
  // SETUP (see README.md): no KV needed (each submission is a new conversation).
  //   Secrets: npx wrangler@4 secret put AUTH0_DOMAIN         (Auth0 tenant domain, no scheme)
  //            npx wrangler@4 secret put AUTH_AUDIENCE        (Auth0 API identifier)
  //            npx wrangler@4 secret put INTERCOM_TOKEN
  //            npx wrangler@4 secret put INTERCOM_REGION      (optional: us|eu|au)
  //            npx wrangler@4 secret put INTERCOM_ADMIN_ID    (optional, for tags)
  //            npx wrangler@4 secret put INTERCOM_TAG_IDS     (optional JSON map)
  //            npx wrangler@4 secret put INTERCOM_APP_ID      (optional — convo links in Linear)
  //            npx wrangler@4 secret put LINEAR_API_KEY       (optional — direct Linear issues)
  //            npx wrangler@4 secret put LINEAR_TEAM_ID       (required with LINEAR_API_KEY)
  //            npx wrangler@4 secret put LINEAR_LABEL_IDS     (optional JSON map type→label id)
  //            npx wrangler@4 secret put POSTHOG_PROJECT_URL  (optional — person links)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeros-feedback",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Per-IP rate limit, applied BEFORE auth so an unauthenticated caller cannot
  // make the Worker fetch a JWKS or verify signatures on demand (and so a
  // signed-in user cannot flood the inbox). 5 submissions / 60s / IP is plenty
  // for a human.
  // Unmetered + GA. (namespace_id is just a per-account bucket id — pick any
  // value not already used by another Worker on the same account.)
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
