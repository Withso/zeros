#!/bin/sh
case "${1-}" in
  local|computer|browser) ;;
  *)
    printf '%s\n' 'Only `zeros local`, `zeros computer` and `zeros browser` are available here.' >&2
    exit 2
    ;;
esac

launcher=$0
case "$launcher" in
  */*) ;;
  *) launcher=$(command -v "$launcher") || exit 1 ;;
esac
case "$launcher" in
  /*) ;;
  *) launcher=$PWD/$launcher ;;
esac
while [ -L "$launcher" ]; do
  dir=$(CDPATH= cd -P "$(dirname "$launcher")" && pwd) || exit 1
  target=$(readlink "$launcher") || exit 1
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$dir/$target ;;
  esac
done
dir=$(CDPATH= cd -P "$(dirname "$launcher")" && pwd) || exit 1
exec "$dir/../zeros-engine" "$@"
