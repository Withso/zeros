    "renderer-build": {
      "when": {
        "always": false,
        "full": true,
        "any_lanes": [
          "desktop-renderer",
          "electron",
          "protocol",
          "design-containment",
          "model-catalogs",
          "packaging",
          "dependencies-toolchain"
        ]
      },
      "execution_group": "build",
      "commands": ["pnpm build:ui"]
