          "dependencies-toolchain",
          "packaging"
        ]
      },
      "execution_group": "cloud-runner",
      "commands": [
        "pnpm check:runtime-pins",
        "pnpm agents:smoke:offline",
        "bash scripts/ci/with-userns.sh pnpm check:zsr",
        "bash scripts/ci/with-userns.sh pnpm check:zsr-preview-browser",
        "pnpm --dir apps/control-plane typecheck"
      ],
      "runs_elsewhere": ".github/workflows/cloud-runner-qualification.yml"
