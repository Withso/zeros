    "engine-and-electron-build": {
      "when": {
        "always": false,
        "full": true,
        "any_lanes": [
          "desktop-engine",
          "electron",
          "protocol",
          "design-containment",
          "model-catalogs",
          "packaging",
          "dependencies-toolchain"
        ]
      },
      "execution_group": "build",
      "commands": [
        "pnpm build:engine",
        "pnpm electron:compile",
        "bun build apps/desktop/src/cli.ts --compile --target=bun-darwin-arm64 --outfile <binary>"
      ]
    },
    "web-and-marketing-build": {
      "when": {
        "always": false,
        "full": true,
        "any_lanes": ["web", "marketing", "packaging"]
      },
      "execution_group": "build",
      "commands": [
        "pnpm --filter @zeros/marketing build",
        "npm --prefix apps/web run build:standalone"
      ]
    },
    "source-sync-macos": {
      "when": {
        "always": false,
        "full": true,
        "any_lanes": [
          "desktop-engine",
          "electron",
          "packaging",
          "protocol",
          "design-containment",
          "cloud-runtime",
          "dependencies-toolchain",
          "macos"
        ]
      },
      "execution_group": "source-sync-macos",
      "commands": [
        "pnpm check:runtime-pins",
        "pnpm agents:smoke:offline",
        "pnpm check:zsr:runtime",
        "pnpm build:sidecar",
        "pnpm smoke:engine",
        "pnpm test:workspace-lifecycle",
        "pnpm check:design-containment"
      ],
      "lane": "macos"
    },
    "unsigned-packaging-proof": {
      "when": {
        "always": false,
        "full": true,
        "any_lanes": ["packaging", "dependencies-toolchain"]
      },
      "execution_group": "source-sync-macos",
      "commands": [
        "pnpm build:sidecar",
        "pnpm electron:compile",
        "pnpm build:ui",
        "pnpm smoke:engine",
        "pnpm exec electron-builder --config electron-builder.yml --publish never --dir",
        "pnpm smoke:packaged-pty"
      ],
      "lane": "macos",
      "runs_elsewhere": ".github/workflows/scheduled.yml:macos packaging proof; the macos job floor also selects source-sync verification."
    },
    "cloud-runner": {
      "when": {
        "always": false,
