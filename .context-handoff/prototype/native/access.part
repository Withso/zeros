 {tab==="access"&&<section className="block"><Heading title="Manage access" desc={org?"Choose who can manage permissions for this connection.":"Your personal connection is visible only to you."}>{manager&&org&&!c.delegate&&<Button variant="ghost" size="icon" aria-label="Add a person" onClick={()=>setAdding(!adding)}><Plus/></Button>}</Heading>
 {adding&&org&&manager&&!c.delegate&&<div className="addperson"><span className="avatar">{people.maya.initials}</span><span className="grow">Maya<small>Withso member</small></span><Button variant="ghost" onClick={()=>setAdding(false)}>Cancel</Button><Button onClick={()=>{update({...c,delegate:"view"});setAdding(false)}}>Add</Button></div>}
 <div className="inventory minisection">{org?<><ListRow className="member-disclosure" aria-expanded={roles} onClick={()=>setRoles(!roles)}><span className="circle-icon"><G n={roles?"down":"chev"}/></span><span>Organization roles · Withso<small>2 roles with access</small></span></ListRow>
 {roles&&<div className="role-row">{[["Owners and admins","Full access"],["Members","Can view"]].map(([role,perm])=><div className="grantrow" key={role}><span className="circle-icon"><G n="person"/></span><span className="grow">{role}</span><em>{perm}</em><Badge>Role</Badge></div>)}</div>}
 <div className="grantrow"><span className="avatar">{people.arun.initials}</span><span className="grow">Arun<small>Organization admin</small></span><em>Full access</em></div>
 {c.delegate&&<div className="grantrow"><span className="avatar">{people.maya.initials}</span><span className="grow">Maya<small>Organization member</small></span>{manager?<Picker label="Maya connection permission" value={c.delegate} items={permissionOptions} set={v=>update({...c,delegate:v==="remove"?undefined:v})}/>:<em>{permissionOptions.find(([v])=>v===c.delegate)?.[1]}</em>}</div>}</>:<div className="grantrow"><span className="avatar">{people[user].initials}</span><span className="grow">{people[user].name}<small>Personal owner</small></span><Scope scope={user}/></div>}</div>
 {org&&<section className="block"><Heading title="Repository audiences" desc="Members also need GitHub access to use a repository."/><div className="inventory minisection">{visible.map(r=><div className="access-row" key={r}><G n="repo"/><span className="grow">{r}</span>{canShare?<Picker label={"Audience for "+r} value={c.repos[r]} items={audienceOptions} set={v=>changeRepo(r,v)}/>:<small>{audienceName(c.repos[r])}</small>}</div>)}{!visible.length&&<p className="empty">No eligible repositories.</p>}</div></section>}</section>}
