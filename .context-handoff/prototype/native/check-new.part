 const org=async()=>{await click('Connections');await provider()};
 const personal=async()=>{await click('Integrations');await click(/^GitHub Repositories, pull requests/)};
 const authorize=async login=>click('Authorize @'+login);
 const disconnect=async place=>{await click('Manage '+place+' account');await click('Disconnect '+place);await click('Disconnect account')};
 const startAdd=async owner=>{await click('Add connection');await tab('Withso');await pick('GitHub account','@'+owner);await click('Continue')};
 await org();await click('Configure account identity');await btn('Manage Local account').waitFor();await btn('Manage Cloud account').waitFor();
 await click('Manage Local account');assert.equal(await page.locator('.method-option').count(),3);await click(/^GitHub App Select/);
 await click('Preview timeout');await page.getByText('Your saved account is still connected.').waitFor();await click('Try again');await authorize('arun-withso');
 await page.getByText('@arun-withso · GitHub App',{exact:true}).waitFor();
 await click('Manage Local account');await click(/^Personal access token Verify/);await click('Verify sample token');await page.getByText('@iamarunrk · Personal access token').waitFor();
 await click('Manage Local account');await click(/^GitHub CLI Use/);await click('Use CLI account');
 await click('Manage Cloud account');assert.equal(await page.locator('.method-option').count(),2);
 await click(/^Personal access token Verify/);await click('Verify sample token');await disconnect('Cloud');assert.equal(await page.getByText('@iamarunrk · GitHub CLI').count(),1);
 await click('Back to Integrations');await page.getByText('Partially connected',{exact:true}).waitFor();await org();
 await click(/^@Withso .*Link/);await authorize('iamarunrk');await page.getByRole('tab',{name:'Repositories'}).waitFor();await tab('Repositories');assert.equal(await page.locator('.repotoggle').count(),7);await close();
 await personal();await disconnect('Cloud');await org();await startAdd('Studio-Labs');await authorize('arun-withso');await page.getByText('GitHub owner approval required',{exact:true}).waitFor();
 await click('Choose another account');await authorize('iamarunrk');await page.getByText('Install Zeros on GitHub',{exact:true}).waitFor();
 await page.getByText('Studio-Labs/patterns',{exact:true}).click();await click('Install and continue');await close();
 await startAdd('Studio-Labs');await page.getByText('Link existing installation',{exact:true}).waitFor();await page.getByText('Studio-Labs/patterns',{exact:true}).click();await click('Link selection');await click('Save connection');await btn(/^@Studio-Labs /).waitFor();
 await startAdd('Northstar');await page.getByText('Link existing installation',{exact:true}).waitFor();await page.getByText('Northstar/dashboard',{exact:true}).click();await click('Link selection');await click('Save connection');
 await click(/^@iamarunrk /);await tab('Manage access');
 await pick('Personal repository to share','0kit');assert(await btn('Share repository').isDisabled());await page.getByText('GitHub access required',{exact:true}).waitFor();
 await pick('Share with member','Sam');await page.getByText('GitHub account required',{exact:true}).waitFor();assert(await btn('Share repository').isDisabled());
 await pick('Share with member','Maya');await pick('Personal repository to share','field-notes');await btn('Share repository').click();await close();
 await pick('Preview as','Maya · Member');await page.getByText('Shared with you',{exact:true}).waitFor();await page.getByText('iamarunrk/field-notes',{exact:true}).waitFor();assert.equal(await btn(/^@iamarunrk /).count(),0);
 await click('Projects');await click('New project');await page.getByRole('checkbox',{name:'iamarunrk/field-notes'}).waitFor();assert.equal(await page.getByText('iamarunrk/0kit').count(),0);await close();
 await org();await pick('Preview as','Arun · Admin');await click(/^@iamarunrk /);await tab('Manage access');await click('Revoke iamarunrk/field-notes for Maya');await close();await pick('Preview as','Maya · Member');assert.equal(await page.getByText('Shared with you',{exact:true}).count(),0);
 await personal();await disconnect('Local');await disconnect('Cloud');await click('Back to Integrations');await page.getByText('Not connected',{exact:true}).waitFor();
 await click(/^GitHub Repositories, pull requests/);await click('Connect Cloud');await click(/^GitHub App Select/);await authorize('maya-dev');await btn('Manage Cloud account').waitFor();await click('Connect Local');await click(/^GitHub CLI Use/);await click('Use CLI account');await btn('Manage Local account').waitFor();
 await page.setViewportSize({width:390,height:844});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await click('Manage Cloud account');assert(await page.evaluate(()=>{const el=document.querySelector('[role=dialog]');return el.scrollWidth<=el.clientWidth+1}));await close();
 assert.deepEqual(errors,[]);assert.deepEqual(reqs,[]);console.log('Personal methods, independent disconnects, chooser, timeout, reusable installation, install continuation, authorization failure, eligible and blocked private shares, revocation, narrow layout and offline bundle passed.');
