 {tab==="repos"&&<section className="block"><Heading title="Repositories" desc={edit?"Select repositories to make available through this connection.":"Repositories available through this connection."}/>
 {edit?<div className="minisection"><CheckList items={catalog[c.owner].map(r=>c.owner+"/"+r[0])} chosen={selected} set={setSelected}/><div className="actions"><Button variant="ghost" onClick={()=>setEdit(false)}>Cancel</Button><Button variant="primary" disabled={!selected.length} onClick={()=>{update({...c,repos:Object.fromEntries(selected.map(r=>[r,c.repos[r]||user]))});setEdit(false)}}>Save selection</Button></div></div>:<>
 <div className="inventory minisection"><div className="searchbar"><G n="search"/><Input appearance="inline" type="search" aria-label="Search repositories" placeholder="Search repositories…" value={q} onChange={e=>setQ(e.target.value)}/>{canConfigure&&<Button variant="ghost" size="compact" onClick={()=>setSync(true)}><RefreshCw/>Refetch repo list</Button>}</div>
 {visible.filter(r=>r.toLowerCase().includes(q.trim().toLowerCase())).map(r=>{const used=allowedProjects.filter(p=>p.repos.includes(r)&&(org?p.scope==="org":p.scope===user));return <React.Fragment key={r}><ListRow className="repotoggle" aria-expanded={expanded===r} onClick={()=>setExpanded(expanded===r?"":r)}><span className="grow">{r}</span><Badge>{isPublic(r)?"Public":"Private"}</Badge></ListRow>{expanded===r&&<div className="repodetail">{org?audienceName(c.repos[r]):"Only you"} · {used.length?"Used by "+used.map(p=>p.name).join(", "):"No visible projects using this source"}</div>}</React.Fragment>})}{!visible.some(r=>r.toLowerCase().includes(q.trim().toLowerCase()))&&<p className="empty">No matching repositories.</p>}</div>
 <div className="listfoot"><span role="status">{sync?"Last fetched just now":"Last fetched 16 hours ago"}</span>{manager&&<Button variant="ghost" size="compact" onClick={()=>{setSelected(Object.keys(c.repos));setEdit(true)}}><SlidersHorizontal/>Add or remove repositories</Button>}</div></>}</section>}</Drawer>
