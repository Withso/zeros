{
  // Type-check-only config (no emit) for apps/desktop/src/.
  //
  // The app is built by Vite (renderer) and tsup (engine + Electron main), and
  // BOTH esbuild-strip types WITHOUT checking them — so nothing actually
  // type-checks desktop source at build time. This config is that missing gate:
  // it runs the native TypeScript 7 compiler (`tsgo --noEmit`) over
  // apps/desktop/src/ under the repo's strict settings (inherited via
  // ./tsconfig.json → ./tsconfig.build.json), wired as `pnpm typecheck:app` and
  // run as a blocking Preflight CI check. Editors, ESLint and the scripts that
  // import the compiler API keep the `typescript` 5.x package; keep this program
  // valid under both compilers.
  //
  // It widens `lib` beyond tsconfig.build.json (which is engine-oriented):
  // DOM/DOM.Iterable because the renderer uses browser globals,
  // and `types: ["node"]` so the engine half resolves Node APIs deterministically
  // (otherwise node imports silently degrade to `any` under moduleResolution:bundler).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Inherited from the build config, but this program never emits. The native
    // compiler would otherwise compute declaration-portability diagnostics that
    // `tsc` 5.x never reported under noEmit, and spend time doing it.
    "declaration": false,
    "declarationMap": false,
    // Repeated local runs (agents re-run `pnpm typecheck` after every change)
    // re-check only what changed. The build info stays in node_modules/.cache,
    // never in source; a fresh checkout or CI still checks everything. The
    // native compiler's build info has its own name, so switching to a branch
    // that still runs `tsc` 5.x never discards it.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/zeros-typecheck/app.native.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["apps/desktop/src"]
}
